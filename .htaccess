# Serve the frontend at the site root and disable directory listings.
Options -Indexes
DirectoryIndex index.html

# Block hidden URL paths while allowing the well-known namespace used by
# services such as certificate validation. Configure HTTPS redirects in the vhost.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L]
</IfModule>

# Apply browser security policies. The CSP allows the Turnstile widget and
# external HTTPS cover images while restricting scripts to known origins.
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data:; connect-src 'self' https://challenges.cloudflare.com; upgrade-insecure-requests"
</IfModule>

# Deny access to local data and operational files if they are copied here.
<FilesMatch "(?i)^savepoint-(?:stara-)?kolekcja(?:[-_.][a-z0-9_.-]+)?\.json$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)(^\.|\.local\.php$|\.(md|sql|bak|old|orig|save|tmp|log|ini|env|toml|zip|7z|tgz|tar|gz|xz|bz2|key|pem|p12|pfx)$)">
    Require all denied
</FilesMatch>

# Revalidate the document and unversioned assets so new deployments propagate.
<IfModule mod_headers.c>
    <FilesMatch "^(index\.html)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(css|js|ico|png|svg|webp)$">
        Header set Cache-Control "no-cache" "expr=%{QUERY_STRING} !~ /(^|&)v=[a-zA-Z0-9-]+(&|$)/"
        Header set Cache-Control "public, max-age=604800, immutable" "expr=%{QUERY_STRING} =~ /(^|&)v=[a-zA-Z0-9-]+(&|$)/"
    </FilesMatch>
</IfModule>

# Compress public text while leaving authenticated responses out of the filter.
<IfModule mod_filter.c>
    <IfModule mod_deflate.c>
        <FilesMatch "\.(html|css|js|svg)$">
            AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
        </FilesMatch>
    </IfModule>
</IfModule>
